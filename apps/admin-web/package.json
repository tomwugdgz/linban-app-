{
  "name": "@linban/admin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "邻伴管理后台 Web（React 18 + Vite + TS + AntD 5）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -b tsconfig.node.json",
    "smoke": "node scripts/check-collection.mjs && node scripts/esbuild-smoke.mjs && node scripts/smoke.mjs && npx tsx scripts/community-source-guard.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@linban/shared": "1.0.0",
    "antd": "^5.21.6",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "~5.6.2",
    "vite": "^5.4.8"
  }
}
