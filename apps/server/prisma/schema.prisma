/// 子女授权范围（架构 §10.1：基础 / 服务进度 / 全部）
enum auth_level {
  BASIC
  PROGRESS
  FULL
}

/// 家庭绑定状态
enum family_binding_status {
  PENDING
  ACTIVE
  REVOKED
}

/// 孝心时长卡状态
enum gift_card_status {
  ACTIVE
  USED
  EXPIRED
  REFUNDED
