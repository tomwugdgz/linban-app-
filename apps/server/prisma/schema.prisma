/// IM 消息类型
enum im_message_type {
  TEXT
  IMAGE
  VOICE
  SYSTEM
}

/// IM 消息状态：撤回 / 被拦截（风控命中）
enum im_message_status {
  NORMAL
  REVOKED
  BLOCKED
}

/// IM 内容审核状态（微信 msgSecCheck/imgSecCheck + 人工）
enum im_review_status {
  PENDING
  PASS
  REJECT
}

/// IM 发送方角色
enum im_sender_role {
  USER
  COMPANION
  SYSTEM
}

/// 隐私号绑定状态
enum privacy_binding_status {
  ACTIVE
  EXPIRED
  UNBOUND
}

/// 评价审核状态
enum review_status {
  PENDING
