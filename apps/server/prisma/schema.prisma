// ============================================================================
// 邻伴 · 社区养老陪伴匹配平台 —— Prisma Schema（v1.0）
// 作者：宋砚秋（Cyrus Ledger）｜ 团队：rnd-linban ｜ 2026-09
// 上游依据：docs/ARCHITECTURE.md v1.0（顾图南）——表名/状态枚举/配置默认值
// 均以架构文档为单一事实源，不得在本文件自创状态或模块。
//
// 约定（详见 docs/DATABASE.md）：
//   1. 金额一律 BigInt 存「分」，禁止浮点；抽成比例用基点(bp)整数快照。
//   2. 主键 BigInt 自增；业务单号（order_no/payment_no/...）独立唯一列。
//   3. 时间统一存 UTC（MySQL DATETIME(3)），仅在展示层转 Asia/Shanghai。
//   4. 模型 PascalCase + @@map 到下划线表名；字段直接下划线命名，无需 @map。
//   5. MySQL 无部分唯一索引：「仅一条生效」语义用可空守卫列
//      （slot_guard / active_key，生效时存常量、失效时置 NULL）实现。
//   6. 加密字段（_cipher）为 AES-256-GCM base64 密文；_hmac 为 HMAC-SHA256
//      盲索引（hex），仅手机号等需检索字段建唯一索引。
//   7. 一切资金/服务动作可回放：流水表（payments/profit_sharing_records/
//      deposit_transactions/order_timeline/credit_logs/audit_logs）只插入不更新。
//   8. 实现注意（服务端集成必读）：
//      a. BigInt 字段（金额/ID）在 Node 侧为原生 BigInt，JSON.stringify 会抛
//         "Do not know how to serialize a BigInt"——API 出参必须统一转字符串
//         （响应拦截器或 toJSON 助手），杜绝浮点与精度丢失。
//      b. DATABASE_URL 须带 timezone=UTC（如 ...?timezone=UTC），MySQL 容器
//         time_zone='+00:00'；全链路存 UTC，仅展示层转 Asia/Shanghai。
//      c. 守卫列（slot_guard/active_key）由服务层维护：占用/生效置常量，
//         释放/失效置 NULL；DB 无触发器、无部分索引可替代。
//      d. JSON 列无 DB 默认值，写入必须给完整对象；枚举落 VARCHAR，新增值
//         无需 DDL，删除/改名前必须先清存量数据并停用代码引用。
//      e. 迁移：开发期 migrate dev，生产 migrate deploy 且先备份（见 DATABASE.md §9）。
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 枚举定义（订单/四审/分账等状态机与架构 §6.5/§6.6/§7 严格一致）
// ---------------------------------------------------------------------------

/// 三端账号角色：老人 / 子女（代操作）/ 陪聊员；后台角色走 admins-roles RBAC
enum user_role {
  ELDER
  FAMILY
  COMPANION
  /// 系统服务账号（主理人裁定 A2，2026-10）：仅供系统自动流程引用
  /// （健康告警 escalate 落 complaints 的 complainant_id 必填 FK，无真人发起方）。
  /// 约束：不可登录、不得被业务接口选为操作人、不计入任何用户/陪聊员统计口径。
  SYSTEM
}

/// 账号状态：CANCELLED = 注销冷静期及以后（到期匿名化，见 §10.1）
enum user_status {
  ACTIVE
  FROZEN
  CANCELLED
}

/// 订单状态机（架构 §6.5，12 态，禁止增删）
enum order_status {
  CREATED           // 下单锁时段，15min 支付超时
  PAID              // 支付成功，待分账冻结
  DISPATCHED        // 派单引擎 TopN 推送
  ACCEPTED          // 陪聊员接单
  ARRIVED           // 到岗核销通过
  IN_SERVICE        // 服务中
  PENDING_CONFIRM   // 服务结束待双方确认
  COMPLETED         // 双方确认完成（触发分账）
  SUSPENDED         // 异常/投诉挂起（客服裁决）
  CANCELLED         // 取消（未服务或违约取消）
  CLOSED            // 评价完成/超时关闭
  REFUNDED          // 已退款（分账回退完成）
}

/// 服务类型（主理人裁定：MVP 只开 CHAT；ACCOMPANY 枚举预留、后台不开入口）
enum service_type {
  CHAT       // 陪聊
  ACCOMPANY  // 陪行/陪逛（预留，MVP 不开放）
}

/// 支付单状态（对齐微信交易状态语义）
enum payment_status {
  PENDING   // 待支付
  SUCCESS   // 支付成功
  REFUNDED  // 已全额退款（部分退见 refund_amount_fen）
  CLOSED    // 超时关单
  FAILED    // 支付失败
}

/// 分账记录三态（架构 §5.1/§7：冻结 → 已分账 / 已回退）
enum profit_sharing_status {
  FROZEN    // 待分账冻结（付款即冻，陪聊员可见不可取）
  SHARED    // 已分账（平台留成 + 陪聊员直达）
  RETURNED  // 已回退（解冻/回退用户）
}

/// 提现单状态（备选结算模式使用；默认分账直达模式下低频）
enum withdrawal_status {
  PENDING_REVIEW // 待审核（T+1，finance 角色）
  APPROVED       // 审核通过
  REJECTED       // 审核驳回
  PROCESSING     // 微信提现处理中
  SUCCESS        // 到账成功
  FAILED         // 到账失败
}

/// 对账渠道
enum recon_channel {
  WX_PAY      // 微信支付
  WX_SHARING  // 微信分账
  WX_REFUND   // 微信退款/回退
  WX_WITHDRAW // 微信商户提现
}

/// 对账批次状态
enum recon_status {
  PENDING  // 待执行
  RUNNING  // 执行中
  MATCHED  // 无差异
  DIFF     // 有差异（告警）
  RESOLVED // 差异已处理
}

/// 陪聊员四审流阶段（架构 §6.6，10 态，禁止增删）
enum application_stage {
  APPLIED      // 注册申请
  REALNAME_OK  // ①实名通过
  FACE_OK      // ②人脸通过
  CRIMINAL_OK  // ③无犯罪记录通过
  TRAINING     // 培训中
  EXAM_OK      // 考试通过（≥80 分）
  DEPOSIT_OK   // ④保证金缴纳完成
  ACTIVE       // 四审通过，上架接单
  SUSPENDED    // 暂停接单
  BANNED       // 黑名单清退
}

/// 四审单步审核结果
enum step_status {
  PENDING
  PASSED
  REJECTED
}

/// 陪聊员主档状态（与 §6.6 的 ACTIVE/SUSPENDED/BANNED 对齐；
/// PENDING=审核中未上架；RETIRED=正常退出，保证金 30 天无纠纷原路退）
enum companion_status {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
  RETIRED
}

/// 核销类型：到岗核销 / 完成确认（双方确认）
