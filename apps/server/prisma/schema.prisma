/// 文件类型（COS 对象分类，内容不落库，仅存 objectKey）
enum file_type {
  FACE_PHOTO         // 人脸签到照
  LIVENESS_VIDEO     // 活体视频
  ID_CARD_FRONT      // 身份证人像面
  ID_CARD_BACK       // 身份证国徽面
  CRIMINAL_CERT      // 无犯罪记录证明
  TRAINING_MATERIAL  // 培训材料
  SERVICE_LOG        // 服务日志
  SOS_RECORD         // SOS 记录
  COMPLAINT_EVIDENCE // 投诉证据
  REPORT_EVIDENCE    // 举报证据
  VOICE_NOTE         // 语音留言
  OTHER
