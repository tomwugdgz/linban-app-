{
  "name": "@linban/server",
  "version": "1.0.0",
  "description": "邻伴服务端：Express 4 + TypeScript + Prisma 5（模块化单体，按业务边界拆分 13+2 模块）",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/app.ts",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "tsx src/app.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run test:collect",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:collect": "tsx scripts/check-test-collection.ts",
    "test:check:collection": "tsx scripts/check-test-collection.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:baseline": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "prisma:migrate:diff": "node scripts/prisma-migrate-diff.mjs",
    "prisma:migrate:check": "node scripts/check-migration-drift.mjs",
    "doc:check:configs": "tsx scripts/verify-doc-configs.ts",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@linban/shared": "*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.25.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pino": "^9.4.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.0",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
