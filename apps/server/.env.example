# ============================================================================
# 邻伴服务端环境变量模板
#
#   cp .env.example .env   然后按下表填入。**本仓库禁止提交真实凭证**。
#
# 三档必填口径（clone 下来的人照这个填即可，不用猜）：
#
#   【A档·必填，缺了服务起不来】
#     DATABASE_URL / REDIS_URL / JWT_ACCESS_SECRET / JWT_REFRESH_SECRET /
#     CRYPTO_MASTER_KEY / CRYPTO_HMAC_KEY
#     —— 缺失表现：应用启动即warn日志明确指出缺哪一项。
#
#   【B 档 · 必填（生产），留空则降级】
#     微信小程序 / 微信支付 / 腾讯云 / COS / LLM 凭据
#     —— 缺失表现：**自动降级到 adapters/mock**，不报错、可跑通全链路。
#     但 mock 只在开发期成立：真机扫码、真实支付、真人脸、真短信一律不可用。
#     上线检查口径：mock 适配器未切换 = 不可上线。
#
#   【C 档 · 可留空（有安全默认值）】
#     端口 / 日志级别 / TTL / 阈值 / 回调 URL 等，留空取括号内默认值。
#
# 生成密钥：
#   openssl rand -base64 32      # 用于 CRYPTO_MASTER_KEY / CRYPTO_HMAC_KEY / JWT_*
#
# 铁律（架构）：任何密钥不得硬编码进代码，全部走env；无凭证环境一律走 mock。
# ============================================================================

# ---- 基础（C 档）----
NODE_ENV=development
PORT=3000                      # 默认 3000
LOG_LEVEL=debug                # debug | info | warn | error
# 定时任务总开关（false 时 cron 只注册不执行，供无 Redis 环境启动）
CRON_ENABLED=true

# ---- 数据库（A 档 · 必填）----
# 架构 §11.1：MySQL 8。连接串**必须带 timezone=UTC**（DATABASE.md §2.6：
# 不带时Prisma 按本地时区解释 Date，导致跨时区订单时段错位）。
DATABASE_URL="mysql://root:change-me@127.0.0.1:3306/linban?timezone=UTC&charset=utf8mb4"

# ---- Redis（A 档 · 必填）----
# 用途：配置热缓存 / 幂等键 / 队列 / 会话 / 分布式锁。
# 缺失表现：服务可启动但排队任务不执行、幂等退化为仅靠 DB 唯一索引。
REDIS_URL="redis://127.0.0.1:6379/0"

# ---- JWT（A 档 · 必填；access 2h + refresh 30d，架构 §3.2/附录 B）----
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL_SEC=7200
REFRESH_TOKEN_TTL_SEC=2592000

# ---- 微信小程序（B 档 · 生产必填；留空 → mock 适配器）----
# code2session（登录）/ 内容安全审核 / 订阅消息推送
# 留空表现：登录走 mock openid（仅开发），真机无法登录。
WX_MINIAPPID=""
WX_MINIAPPSECRET=""

# ---- 微信支付服务商（B 档 · 生产必填；留空 → mock 支付）----
# 服务商商户号；款项 100% 进平台担保户（架构 §7.1）
# 留空表现：prepay 走 mock，可点通但**不产生真实交易**；
#           分账按 SPLIT_MODE 走人工兜底；微信回调验签必然失败。
WXPAY_SP_MCHID=""
WXPAY_SUB_MCHID=""
WXPAY_APIV3_KEY=""
WXPAY_CERT_SERIAL_NO=""
# 证书路径（本地文件，不入库；.gitignore 已排除 certs/）
WXPAY_PRIVATE_KEY_PATH="./certs/wxpay/apiclient_key.pem"
WXPAY_CERT_PATH="./certs/wxpay/apiclient_cert.pem"
# 回调 URL 必须是**公网可访问**且已备案的域名（微信侧要求合法域名）
WXPAY_NOTIFY_URL="https://api.example.com/api/v1/payments/wx/notify"
WXPAY_PROFIT_SHARING_NOTIFY_URL="https://api.example.com/api/v1/payments/sharing/wx/notify"
WXPAY_REFUND_NOTIFY_URL="https://api.example.com/api/v1/payments/refund/wx/notify"

# ---- 分账执行模式（C 档 · 由 system_configs.split_mode 驱动，此处为环境默认值）----
# 架构 §7.5/§7.6：
#   wechat_profit_sharing      = 主路径：微信服务商自动分账（分账至个人 openid）
#   manual_settlement_fallback = 兜底：平台收款 + 人工结算（仅灰度联调）
# 上线前必须切回主路径 —— 人工兜底无法规模化。
SPLIT_MODE=manual_settlement_fallback

# ---- 腾讯云统一密钥（B 档；留空 → OCR/慧眼/隐私号/ASR/TTS/SMS 全部 mock）----
TENCENTCLOUD_SECRET_ID=""
TENCENTCLOUD_SECRET_KEY=""
TENCENTCLOUD_REGION=ap-guangzhou

# 慧眼人脸核身（入驻底照 + 到岗活体比对）
# 留空表现：人脸核身走 mock 恒通过 —— **不可用于生产**，等于没有实名核验。
FACE_VERIFY_BIZ_ID=""
FACE_MATCH_THRESHOLD=80         # 活体比对阈值（分）

# 号码隐私保护 AXB（机制 2：真实号码互不可见）
# 留空表现：真实号码互相可见，隐私机制失效。
PRIVACY_NUMBER_SDK_APPID=""
PRIVACY_NUMBER_APPID=""

# ASR / TTS（AI 管道：老人语音转写 + 适老音色合成）
ASR_ENGINE_MODEL_TYPE=16k_zh
TTS_VOICE_TYPE=101001

# 短信（验证码 + 告警兜底）
# 留空表现：验证码在响应体里明文返回（**仅开发**，生产必然泄漏）。
SMS_SDK_APPID=""
SMS_SIGN_NAME=邻伴
SMS_TEMPLATE_ID_CODE=""

# COS 对象存储（留痕文件私有读 + STS 直传）
# 留空表现：文件上传走 mock，图片不可访问。
COS_BUCKET=""
COS_REGION=ap-guangzhou
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_STS_ROLE_ARN=""

# ---- LLM（B 档；留空 → 走 mock 管道，AI 话术为固定文案）----
LLM_PROVIDER=deepseek
LLM_API_KEY=""
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_PROVIDER=doubao
LLM_FALLBACK_API_KEY=""
LLM_FALLBACK_MODEL=""

# ---- 腾讯地图（B 档；留空 → 距离/导航/地理编码降级，不影响主链路）----
MAP_KEY=""

# ---- 保险渠道（C 档 · MVP 半自动，留空则保单/理赔不落库）----
INSURANCE_API_BASE=""
INSURANCE_API_KEY=""

# ---- 加密（A 档 · 必填；DATABASE.md §6.2）----
# AES-256-GCM 主密钥：base64 编码 32 字节；HMAC 盲索引密钥：base64 编码 32 字节。
#开发期：`openssl rand -base64 32`；生产经 KMS 信封加密托管（不落盘明文）。
# 缺失表现：**不报错但落明文**——字段值以 `PLAIN_DEV:` 前缀存库。
#   这意味着加密形同虚设，且存量数据无法回补，只能全量刷库。**上线前必查。**
CRYPTO_MASTER_KEY=""
CRYPTO_HMAC_KEY=""

# ---- 管理后台（C 档；seed.ts 初始超管用）----
ADMIN_LOGIN_FAIL_MAX=5           # 连续失败上限
ADMIN_LOGIN_LOCK_MIN=30         # 锁定分钟
# 初始超管种子账号（seed.ts 使用；**生产必须改密**）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin

# ============================================================================
# 上线前必查清单（缺一项都不可上线）：
#   1. CRYPTO_MASTER_KEY / CRYPTO_HMAC_KEY 已配 —— 否则明文落库
#   2. SPLIT_MODE=wechat_profit_sharing —— 否则分账走人工兜底
#   3. 全部 B 档凭据已配 —— 任一为空都意味着该能力是mock
#   4. SEED_ADMIN_PASSWORD 已改 —— 种子密码是公开的
#   5. WXPAY_*_NOTIFY_URL 指向已备案公网域名
#   6. JWT 两项 secret 非模板值 —— 泄露即可伪造任意身份
# ============================================================================