# 邻伴·陪聊员端小程序 开发环境变量（微信开发者工具）
# TARO_APP_ 前缀变量由 Taro DefinePlugin 在编译期注入 process.env

TARO_APP_NAME=linban-companion

# API 基础路径
# TODO(主理人/运维)：替换为已备案域名，形如 https://api.linban.com/api/v1
TARO_APP_BASE_URL=https://api.linban.dev/api/v1

# mock 适配层开关：true=无后端环境也可点通核心链路；后端联调就绪后置 false
TARO_APP_USE_MOCK=true
